# Binaries
bin/
# dist/* (not dist/) so the web/dist/.gitkeep negation below can work: git
# cannot re-include a file whose parent directory is excluded.
dist/*
!dist/.gitkeep
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.out

# Go workspace
go.work
go.work.sum

# Build and tool caches
.cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Frontend (built assets — .gitkeep is tracked so the embed dir always exists)
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Database (runtime)
skopos.db
skopos.db-shm
skopos.db-wal

# Configuration (runtime; copy from skopos-config.example.toml)
skopos-config.toml

# Skopos session ID files (auto-generated per workspace)
.skopos-session

.skopos/

# agent-builder compiled output (generated by `agent-builder compile`)
docs/integrations/agent-builder/build/
